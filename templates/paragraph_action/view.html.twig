{% extends 'base.html.twig' %}

{% block title %}Paragraph Actions{% endblock %}

{% block body %}
<div class="container-fluid mt-3 mb-3">
  <p class="hidden" id="title">{{title}}</p>
  <p class="hidden" id="gamebook">{{gamebook}}</p>
  <p class="hidden" id="paragraph">{{paragraph}}</p> 
  {% if app.user != null %}
    <div class="row">
      <div class="col-sm-12 col-md-4" id="searchBox">
      <a class="text-decoration-none" href="{{ path('paragraphaction_create', {'gamebook': gamebook, 'paragraph': paragraph}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Paragraph Action</button></a>   
      {{ knp_pagination_filter(pagination, {'p.number': 'Paragraph', 'pa.text': 'Text', 'pat.name': 'Paragraph Action Target','pac.name': 'Paragraph Action Category', 'pao.name': 'Paragraph Action Operator', 'pa.actionvalue': 'Paragraph Action Value', 'paa.name': 'Paragraph Action Attribute'}) }}
      </div>
      <div class="col-sm-12 col-md-8 table-responsive" id="tableView">
      <a id="toggleSearch" class="nav-link text-white text-center paleRed">Search</a>
        <table class="table table-striped table-light">
          <thead>
            <tr>
              <th class="smallHead">Text</th>
              <th class="smallOptions">Options</th>
              <th class="smallBody">Gamebook</th>
              <th class="smallBody">Paragraph</th>
              <th class="smallBody">Paragraph Action Target</th>
              <th class="smallBody">Paragraph Action Category</th>
              <th class="smallBody">Paragraph Action Operator</th>
              <th class="smallBody">Paragraph Action Value</th>
              <th class="smallBody">Paragraph Action Attribute</th>
              <th class="smallBody">Number of Dice</th>
              <th class="smallBody">Paragraph Action Equipment Required</th>
              <th class="smallBody">Paragraph Action Spell Required</th>
              <th class="smallBody">Paragraph Action Enemy Required</th>
              <th class="smallBody">Delete</th>
            </tr>
          </thead>
          <tbody name="paragraphactionTable" id="paragraphactionTable">
            {% for paragraphaction in pagination %}
            {% set id = paragraphaction.id %}
              <tr>
                <td class="smallHead"><a class="btn btn-secondary btn-sm" href="{{ path('paragraphaction_edit', {'id': paragraphaction.id, 'gamebook': gamebook, 'paragraph': paragraph}) }}">{{ paragraphaction.text }}</a></td>
                <td class="smallOptions"><button type="button" class="btn btn-primary btn-sm smallOptionsLink">Options</button></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('gamebook_view', {'gamebook': gamebook}) }}">Gamebook: <span class="gamebookTable"></span></a></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('paragraph_view', {'gamebook': gamebook}) }}">Paragraph: {{ paragraphaction.paragraph }}</a></td>
                <td class="smallBody smallOptionsList">{{ paragraphaction.paragraphactiontarget }}</td>
                <td class="smallBody smallOptionsList">{{ paragraphaction.paragraphactioncategory }}</td>
                <td class="smallBody smallOptionsList">{{ paragraphaction.paragraphactionoperator }}</td>
                <td class="smallBody smallOptionsList">{{ paragraphaction.actionvalue }}</td>
                <td class="smallBody smallOptionsList">{{ paragraphaction.paragraphactionattribute }}</td>
                <td class="smallBody smallOptionsList">{{ paragraphaction.numberdice }}</td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('paragraphactionequipmentrequired_view', {'paragraph': paragraph, 'gamebook': gamebook, 'paragraphaction': paragraphaction.id }) }}">Add Equipment Required</a></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('paragraphactionspell_view', {'paragraph': paragraph, 'gamebook': gamebook, 'paragraphaction': paragraphaction.id }) }}">Add Spell Required</a></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('paragraphactionenemy_view', {'paragraph': paragraph, 'gamebook': gamebook, 'paragraphaction': paragraphaction.id }) }}">Add Enemy Required</a></td>
                <td class="smallBody smallOptionsList smallOptionsAction">
                  <form action="{{ path('generic_delete', {'entity': 'paragraphaction', 'id': paragraphaction.id}) }}" method="post" onsubmit="return confirm('Delete this? This cannot be undone.');">
                    <input type="hidden" name="redirect" value="{{ app.request.requestUri }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_paragraphaction_' ~ paragraphaction.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {{ knp_pagination_render(pagination, null, {}, {
        'align': 'center',
        'size': 'small',
        'rounded': true,
        }) }}
      </div>
    </div>
    <div class="options-modal" id="optionsModal" aria-hidden="true">
      <div class="options-modal__backdrop" data-modal-close></div>
      <div class="options-modal__dialog" role="dialog" aria-modal="true" aria-label="Row options">
        <div class="options-modal__header">
          <span>Options</span>
          <button type="button" class="options-modal__close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="options-modal__body" id="optionsModalBody"></div>
      </div>
    </div>
  {% endif %}           
</div>
{% endblock %}
