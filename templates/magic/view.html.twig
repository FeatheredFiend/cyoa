{% extends 'base.html.twig' %}

{% block title %}Magic{% endblock %}

{% block body %}
<div class="container-fluid mt-3 mb-3">
  <p class="hidden" id="title">{{title}}</p>
  <p class="hidden" id="gamebook">{{gamebook}}</p>
  <p class="hidden" id="paragraph">{{paragraph}}</p> 
  {% if app.user != null %}
    <div class="row">
      <div class="col-sm-12 col-md-4" id="searchBox">
      <a class="text-decoration-none" href="{{ path('magic_create', {'gamebook': gamebook, 'paragraph': paragraph}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Magic</button></a>
      <a class="text-decoration-none" href="{{ path('magiceffect_create') }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Magic Effect</button></a>
      <a class="text-decoration-none" href="{{ path('magiceffectattribute_create') }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Magic Effect Attribute</button></a>
      <a class="text-decoration-none" href="{{ path('magiceffectoperator_create') }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Magic Effect Operator</button></a>
      {{ knp_pagination_filter(pagination, {'m.name': 'Magic Name'}) }}
      </div>
      <div class="col-sm-12 col-md-8 table-responsive" id="tableView">
      <a id="toggleSearch" class="nav-link text-white text-center paleRed">Search</a>
        <table class="table table-striped table-light">
          <thead>
            <tr>
              <th class="smallHead">Name</th>
              <th class="smallOptions">Options</th>
              <th class="smallBody">Magic Effect</th>
              <th class="smallBody">Delete</th>
            </tr>
          </thead>
          <tbody name="magicTable" id="magicTable">
            {% for magic in pagination %}
            {% set id = magic.id %}
              <tr>
                <td class="smallHead"><a class="btn btn-secondary btn-sm" href="{{ path('magic_edit', {'gamebook': gamebook, 'paragraph': paragraph, 'id': magic.id}) }}">{{ magic.name}}</a></td>
                <td class="smallOptions"><button type="button" class="btn btn-primary btn-sm smallOptionsLink">Options</button></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('magiceffect_view') }}">Magic Effect</a></td>
                <td class="smallBody smallOptionsList smallOptionsAction">
                  <form action="{{ path('generic_delete', {'entity': 'magic', 'id': magic.id}) }}" method="post" onsubmit="return confirm('Delete this? This cannot be undone.');">
                    <input type="hidden" name="redirect" value="{{ app.request.requestUri }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_magic_' ~ magic.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {{ knp_pagination_render(pagination, null, {}, {
        'align': 'center',
        'size': 'small',
        'rounded': true,
        }) }}
      </div>
    </div>
    <div class="options-modal" id="optionsModal" aria-hidden="true">
      <div class="options-modal__backdrop" data-modal-close></div>
      <div class="options-modal__dialog" role="dialog" aria-modal="true" aria-label="Row options">
        <div class="options-modal__header">
          <span>Options</span>
          <button type="button" class="options-modal__close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="options-modal__body" id="optionsModalBody"></div>
      </div>
    </div>
  {% endif %}           
</div>
{% endblock %}
