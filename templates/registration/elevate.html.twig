{% extends 'base.html.twig' %}
{% block title %}Elevate User{% endblock %}
{% block body %}
<div class="auth-shell">
    <div class="card-body">
        <div class="card-header">Elevate User</div>
        {% if app.user != null %}
            <p class="hidden" id="title">{{title}}</p>
            {{ form_start(form) }}
            <div class="form-group">
                {{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_row(form.admin, {'attr': {'class': 'form-control'}}) }}
            </div>
            <button type="submit" class="btn btn-primary w-100">Elevate User</button>
            {{ form_end(form) }}
        {% endif %}
    </div>
</div>
{% endblock %}
