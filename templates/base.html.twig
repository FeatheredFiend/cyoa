<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Symfony CYOA{% endblock %}</title>
        <meta name="color-scheme" content="dark">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🗡️</text></svg>">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <div class="flash-stack">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success flash-toast">
                    <p>{{ message }}</p>
                    <button type="button" class="flash-toast__close" aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('failure') %}
                <div class="alert alert-danger flash-toast">
                    <p>{{ message }}</p>
                    <button type="button" class="flash-toast__close" aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
        </div>
        <header class="site-header">
            <div class="site-header__inner">
                <a class="brand" href="{{ app.user ? path('homepage') : path('app_login') }}">
                    <span class="brand__mark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 4.5C2 3.4 2.9 2.5 4 2.5h6a2 2 0 0 1 2 2v15a1.5 1.5 0 0 0-1.5-1.5H2z"/>
                            <path d="M22 4.5c0-1.1-.9-2-2-2h-6a2 2 0 0 0-2 2v15a1.5 1.5 0 0 1 1.5-1.5H22z"/>
                        </svg>
                    </span>
                    <span class="brand__text">Symfony CYOA</span>
                </a>

                <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>

                <nav class="site-nav" id="siteNav">
                    <ul class="site-nav__list">
                        {% if app.user %}
                            {% if app.user.admin == 1 %}
                                <li>
                                    <a class="site-nav__link" href="{{ path('admin') }}">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5z"/><path d="m9 12 2 2 4-4"/></svg>
                                        Admin
                                    </a>
                                </li>
                            {% endif %}
                            <li>
                                <a class="site-nav__link site-nav__link--logout" href="{{ path('app_logout') }}">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                                    Logout
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a class="site-nav__link site-nav__link--accent" href="{{ path('registration') }}">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="4"/><path d="M2 21v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 3 1"/><path d="M19 8v6M22 11h-6"/></svg>
                                    Register
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            </div>
        </header>
        <main class="site-main">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
