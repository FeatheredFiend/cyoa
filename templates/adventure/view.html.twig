{% extends 'base.html.twig' %}

{% block title %}Adventures{% endblock %}

{% block body %}
<div class="container-fluid mt-3 mb-3">
  <p class="hidden" id="title">{{title}}</p> 
  {% if app.user != null %}
    <div class="row">
      <div class="col-sm-12 col-md-4" id="searchBox">
      <a class="text-decoration-none" href="{{ path('adventure_create') }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Adventure</button></a>   
      {{ knp_pagination_filter(pagination, {'u.name': 'User', 'g.name': 'Gamebook', 'h.name': 'Hero', 'a.timeelapsed': 'Time Elapsed', 'a.name': 'Adventure Name'}) }}
      </div>
      <div class="col-sm-12 col-md-8 table-responsive" id="tableView">
      <a id="toggleSearch" class="nav-link text-white text-center paleRed">Search</a>
        <table class="table table-striped table-light">
          <thead>
            <tr>
              <th class="smallHead">Name</th>
              <th class="smallOptions">Options</th>
              <th class="smallBody">Play</th>
              <th class="smallBody">User</th>
              <th class="smallBody">Gamebook</th>
              <th class="smallBody">Hero</th>
              <th class="smallBody">Time Elapsed</th>
              <th class="smallBody">Delete</th>
            </tr>
          </thead>
          <tbody name="adventureTable" id="adventureTable">
            {% for adventure in pagination %}
              <tr>
                <td class="smallHead">{{ adventure.name }}</td>
                <td class="smallOptions"><button type="button" class="btn btn-primary btn-sm smallOptionsLink">Options</button></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('adventure_play', {'adventure': adventure.id, 'paragraph': adventure.progressparagraph}) }}">Play</a></td>
                <td class="smallBody smallOptionsList">{{ adventure.user }}</td>
                <td class="smallBody smallOptionsList">{{ adventure.gamebook }}</td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('hero_view', {'gamebook': adventure.gamebook, 'hero': adventure.hero, 'adventure': adventure.name}) }}">Hero: {{ adventure.hero }}</a></td>
                <td class="smallBody smallOptionsList">{{ adventure.timeelapsed }}</td>
                <td class="smallBody smallOptionsList smallOptionsAction">
                  <form action="{{ path('generic_delete', {'entity': 'adventure', 'id': adventure.id}) }}" method="post" onsubmit="return confirm('Delete this? This cannot be undone.');">
                    <input type="hidden" name="redirect" value="{{ app.request.requestUri }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_adventure_' ~ adventure.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {{ knp_pagination_render(pagination, null, {}, {
        'align': 'center',
        'size': 'small',
        'rounded': true,
        }) }}
      </div>
    </div>
    <div class="options-modal" id="optionsModal" aria-hidden="true">
      <div class="options-modal__backdrop" data-modal-close></div>
      <div class="options-modal__dialog" role="dialog" aria-modal="true" aria-label="Row options">
        <div class="options-modal__header">
          <span>Options</span>
          <button type="button" class="options-modal__close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="options-modal__body" id="optionsModalBody"></div>
      </div>
    </div>
  {% endif %}           
</div>
{% endblock %}
