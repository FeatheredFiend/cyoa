{% extends 'base.html.twig' %}

{% block title %}Paragraph Equipment{% endblock %}

{% block body %}
<div class="container-fluid mt-3 mb-3">
  <p class="hidden" id="title">{{title}}</p>
  <p class="hidden" id="gamebook">{{gamebook}}</p>
  <p class="hidden" id="paragraph">{{paragraph}}</p> 
  {% if app.user != null %}
    <div class="row">
      <div class="col-sm-12 col-md-4" id="searchBox">
      <a class="text-decoration-none" href="{{ path('equipment_create', {'gamebook': gamebook, 'paragraph': paragraph}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Equipment</button></a>
      <a class="text-decoration-none" href="{{ path('paragraphequipment_create', {'gamebook': gamebook, 'paragraph': paragraph}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Paragraph Equipment</button></a>   
      {{ knp_pagination_filter(pagination, {'p.text': 'Paragraph', 'e.name': 'Equipment'}) }}
      </div>
      <div class="col-sm-12 col-md-8 table-responsive" id="tableView">
      <a id="toggleSearch" class="nav-link text-white text-center paleRed">Search</a>
        <table class="table table-striped table-light">
          <thead>
            <tr>
              <th class="smallHead">Equipment</th>
              <th class="smallOptions">Options</th>
              <th class="smallBody">Gamebook</th>
              <th class="smallBody">Paragraph</th>
              <th class="smallBody">Paragraph Equipment Category</th>
              <th class="smallBody">Quantity</th>
              <th class="smallBody">Delete</th>
            </tr>
          </thead>
          <tbody name="paragraphequipmentTable" id="paragraphequipmentTable">
            {% for paragraphequipment in pagination %}
            {% set id = paragraphequipment.id %}
              <tr>
                <td class="smallHead"><a class="btn btn-secondary btn-sm" href="{{ path('paragraphequipment_edit', {'gamebook': gamebook, 'paragraph': paragraph, 'id': paragraphequipment.id}) }}">{{ paragraphequipment.equipment }}</a></td>
                <td class="smallOptions"><button type="button" class="btn btn-primary btn-sm smallOptionsLink">Options</button></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('gamebook_view', {'gamebook': gamebook}) }}">Gamebook: <span class="gamebookTable">{{gamebook}}</span></a></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('paragraph_view', {'gamebook': gamebook, 'paragraph': paragraph}) }}">Paragraph: {{paragraph}}</a></td>
                <td class="smallBody smallOptionsList">{{ paragraphequipment.paragraphequipmentcategory }}</td>
                <td class="smallBody smallOptionsList">{{ paragraphequipment.quantity }}</td>
                <td class="smallBody smallOptionsList smallOptionsAction">
                  <form action="{{ path('generic_delete', {'entity': 'paragraphequipment', 'id': paragraphequipment.id}) }}" method="post" onsubmit="return confirm('Delete this? This cannot be undone.');">
                    <input type="hidden" name="redirect" value="{{ app.request.requestUri }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_paragraphequipment_' ~ paragraphequipment.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {{ knp_pagination_render(pagination, null, {}, {
        'align': 'center',
        'size': 'small',
        'rounded': true,
        }) }}
      </div>
    </div>
    <div class="options-modal" id="optionsModal" aria-hidden="true">
      <div class="options-modal__backdrop" data-modal-close></div>
      <div class="options-modal__dialog" role="dialog" aria-modal="true" aria-label="Row options">
        <div class="options-modal__header">
          <span>Options</span>
          <button type="button" class="options-modal__close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="options-modal__body" id="optionsModalBody"></div>
      </div>
    </div>
  {% endif %}           
</div>
{% endblock %}
