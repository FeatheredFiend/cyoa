{% extends 'base.html.twig' %}

{% block title %}Welcome to Symfony Create Your Own Adventure!{% endblock %}

{% block body_class %}scene-full{% endblock %}

{% block body %}
<div class="container-fluid">
    <p class="hidden" id="title">{{title}}</p>
    {% if app.user != null %}
        <div class="home-hero">
            <div class="home-hero__sigil" aria-hidden="true">
                <svg viewBox="0 0 200 200" fill="none" stroke="currentColor">
                    <circle cx="100" cy="100" r="96" stroke-width="0.6"/>
                    <circle cx="100" cy="100" r="88" stroke-width="0.4" stroke-dasharray="1 5"/>
                    <circle cx="100" cy="100" r="74" stroke-width="0.6"/>
                    <path d="M100 4 L100 26 M100 174 L100 196 M4 100 L26 100 M174 100 L196 100 M32 32 L48 48 M152 152 L168 168 M168 32 L152 48 M48 152 L32 168" stroke-width="0.8"/>
                    <g class="sigil-inner">
                        <polygon points="100,30 160,135 40,135" stroke-width="0.6"/>
                        <polygon points="100,170 40,65 160,65" stroke-width="0.6"/>
                        <circle cx="100" cy="100" r="34" stroke-width="0.5" stroke-dasharray="2 3"/>
                    </g>
                </svg>
            </div>
            <p class="home-hero__eyebrow">Welcome back, {{ app.user.name }}</p>
            <h1 class="home-hero__title" data-split>Where will your story take you?</h1>
            <p class="home-hero__lede">Pick up a gamebook, choose your hero, and step into the dark.</p>
        </div>
        <div class="home-actions">
            <a class="home-card" href="{{ path('gamebook_view') }}">
                <span class="home-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 4.5C2 3.4 2.9 2.5 4 2.5h6a2 2 0 0 1 2 2v15a1.5 1.5 0 0 0-1.5-1.5H2z"/>
                        <path d="M22 4.5c0-1.1-.9-2-2-2h-6a2 2 0 0 0-2 2v15a1.5 1.5 0 0 1 1.5-1.5H22z"/>
                    </svg>
                </span>
                <h3 class="home-card__title">Gamebooks</h3>
                <p class="home-card__desc">Browse the worlds available to explore.</p>
            </a>
            <a class="home-card" href="{{ path('adventure_view') }}">
                <span class="home-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36z"/>
                    </svg>
                </span>
                <h3 class="home-card__title">Adventures</h3>
                <p class="home-card__desc">Continue a quest or begin a new one.</p>
            </a>
            <a class="home-card" href="{{ path('help_index') }}">
                <span class="home-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M9.5 9a2.5 2.5 0 0 1 4.9.8c0 1.7-2.4 2-2.4 3.7"/>
                        <path d="M12 17.5h.01"/>
                    </svg>
                </span>
                <h3 class="home-card__title">Help</h3>
                <p class="home-card__desc">Read the user guide or check the FAQ.</p>
            </a>
        </div>
    {% else %}
        <p>Please Log in to view this page</p>
    {% endif %}
</div>
{% endblock %}
