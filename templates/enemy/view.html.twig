{% extends 'base.html.twig' %}

{% block title %}Enemies{% endblock %}

{% block body %}
<div class="container-fluid mt-3 mb-3">
  <p class="hidden" id="title">{{title}}</p> 
  <p class="hidden" id="gamebook">{{gamebook}}</p>
  <p class="hidden" id="paragraph">{{paragraph}}</p>   
  {% if app.user != null %}
    <div class="row">
      <div class="col-sm-12 col-md-4" id="searchBox">
      <a class="text-decoration-none" href="{{ path('enemy_create', {'gamebook': gamebook, 'paragraph': paragraph}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Enemy</button></a>   
      {{ knp_pagination_filter(pagination, {'p.number': 'Paragraph', 'e.name': 'Enemy Name', 'e.skill': 'Skill', 'e.stamina': 'Stamina', 'bc.name': 'Battle Category'}) }}
      </div>
      <div class="col-sm-12 col-md-8 table-responsive" id="tableView">
      <a id="toggleSearch" class="nav-link text-white text-center paleRed">Search</a>
        <table class="table table-striped table-light">
          <thead>
            <tr>
              <th class="smallHead">Name</th>
              <th class="smallOptions">Options</th>
              <th class="smallBody">Paragraph</th>
              <th class="smallBody">Skill</th>
              <th class="smallBody">Stamina</th>
              <th class="smallBody">Battle Category</th>
              <th class="smallBody">Image</th>
              <th class="smallBody">Delete</th>
            </tr>
          </thead>
          <tbody name="enemyTable" id="enemyTable">
            {% for enemy in pagination %}
            {% set id = enemy.id %}
              <tr>
                <td class="smallHead"><a class="btn btn-secondary btn-sm" href="{{ path('enemy_edit', {'gamebook': gamebook, 'paragraph': paragraph, 'id': enemy.id}) }}">{{ enemy.name }}</a></td>
                <td class="smallOptions"><button type="button" class="btn btn-primary btn-sm smallOptionsLink">Options</button></td>
                <td class="smallBody smallOptionsList smallOptionsAction"><a class="btn btn-secondary btn-sm" href="{{ path('paragraph_view', {'gamebook': gamebook, 'paragraph': paragraph}) }}">Paragraph: {{ enemy.paragraph }}</a></td>
                <td class="smallBody smallOptionsList">{{ enemy.skill }}</td>
                <td class="smallBody smallOptionsList">{{ enemy.stamina }}</td>
                <td class="smallBody smallOptionsList">{{ enemy.battlecategory }}</td>
                <td class="smallBody smallOptionsList">{{ enemy.image }}</td>
                <td class="smallBody smallOptionsList smallOptionsAction">
                  <form action="{{ path('generic_delete', {'entity': 'enemy', 'id': enemy.id}) }}" method="post" onsubmit="return confirm('Delete this? This cannot be undone.');">
                    <input type="hidden" name="redirect" value="{{ app.request.requestUri }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_enemy_' ~ enemy.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {{ knp_pagination_render(pagination, null, {}, {
        'align': 'center',
        'size': 'small',
        'rounded': true,
        }) }}
      </div>
    </div>
    <div class="options-modal" id="optionsModal" aria-hidden="true">
      <div class="options-modal__backdrop" data-modal-close></div>
      <div class="options-modal__dialog" role="dialog" aria-modal="true" aria-label="Row options">
        <div class="options-modal__header">
          <span>Options</span>
          <button type="button" class="options-modal__close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="options-modal__body" id="optionsModalBody"></div>
      </div>
    </div>
  {% endif %}           
</div>
{% endblock %}
