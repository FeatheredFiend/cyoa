{% extends 'base.html.twig' %}

{% block title %}Paragraph Action Enemy{% endblock %}

{% block body %}
<div class="container-fluid mt-3 mb-3">
  <p class="hidden" id="title">{{title}}</p>
  <p class="hidden" id="gamebook">{{gamebook}}</p>
  <p class="hidden" id="paragraph">{{paragraph}}</p> 
  <p class="hidden" id="paragraphaction">{{paragraphaction}}</p> 
  {% if app.user != null %}
    <div class="row">
      <div class="col-sm-12 col-md-4" id="searchBox">
      <a class="text-decoration-none" href="{{ path('enemy_create', {'gamebook': gamebook, 'paragraph': paragraph}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Enemy</button></a>
      <a class="text-decoration-none" href="{{ path('paragraphactionenemy_create', {'gamebook': gamebook, 'paragraph': paragraph, 'paragraphaction': paragraphaction}) }}"><button type="button" class="col-12 btn-primary d-grid gap-2 nav-link text-white">Create Paragraph Action Enemy</button></a>   
      {{ knp_pagination_filter(pagination, {'paer.text': 'Paragraph Action', 'e.name': 'Enemy'}) }}
      </div>
      <div class="col-sm-12 col-md-8 table-responsive" id="tableView">
      <a id="toggleSearch" class="nav-link text-white text-center paleRed">Search</a>
        <table class="table table-striped table-light">
          <thead>
            <tr>
              <th>Gamebook</th>
              <th>Paragraph</th>
              <th>Paragraph Action</th>
              <th>Enemy</th>
              <th>Delete</th>
            </tr>
          </thead>
          <tbody name="paragraphactionenemyTable" id="paragraphactionenemyTable">
            {% for paragraphactionenemy in pagination %}
            {% set id = paragraphactionenemy.id %}
              <tr>
                <td><a class="nav-link gamebookTable" href="{{ path('gamebook_view', {'gamebook': gamebook}) }}">{{gamebook}}</a></td>
                <td><a class="nav-link" href="{{ path('paragraph_view', {'gamebook': gamebook, 'paragraph': paragraph}) }}">{{paragraph}}</a></td>
                <td><a class="nav-link" href="{{ path('paragraphaction_view', {'gamebook': gamebook, 'paragraph': paragraph}) }}">{{ paragraphactionenemy.paragraphaction.id }}</a></td>
                <td><a class="nav-link" href="{{ path('paragraphactionenemy_edit', {'gamebook': gamebook, 'paragraph': paragraph, 'paragraphaction': paragraphaction, 'id': paragraphactionenemy.id}) }}">{{ paragraphactionenemy.enemy }}</a></td>
                <td>
                  <form action="{{ path('generic_delete', {'entity': 'paragraphactionenemy', 'id': paragraphactionenemy.id}) }}" method="post" onsubmit="return confirm('Delete this? This cannot be undone.');">
                    <input type="hidden" name="redirect" value="{{ app.request.requestUri }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_paragraphactionenemy_' ~ paragraphactionenemy.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {{ knp_pagination_render(pagination, null, {}, {
        'align': 'center',
        'size': 'small',
        'rounded': true,
        }) }}
      </div>
    </div>
  {% endif %}           
</div>
{% endblock %}
